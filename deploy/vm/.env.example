# Copy to deploy/vm/.env on the VM and fill in. NEVER commit the real .env.
# Your VM's public IP with dots replaced by dashes, plus .sslip.io
API_DOMAIN=203-0-113-7.sslip.io

# Same Neon URL you put in Render (must start with postgresql+psycopg://)
GIRIVARSHA_DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST/neondb?sslmode=require

GIRIVARSHA_ENVIRONMENT=production
GIRIVARSHA_CORS_ORIGINS=["https://girivarsha.onrender.com"]
GIRIVARSHA_ACTIVE_RAINFALL_PROVIDER=real
GIRIVARSHA_ACTIVE_SOIL_PROVIDER=real
GIRIVARSHA_ACTIVE_ANTECEDENT_PROVIDER=real
GIRIVARSHA_ACTIVE_SMS_PROVIDER=log_only
