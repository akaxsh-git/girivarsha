# Copy to backend/.env for local (non-docker) development.
GIRIVARSHA_ENVIRONMENT=development
# See README.md "Database" section for how to create this role/db locally.
GIRIVARSHA_DATABASE_URL=postgresql+psycopg://girivarsha:girivarsha@127.0.0.1:5432/girivarsha
# "simulated" (default) or "real". "real" switches to live Open-Meteo data
# (https://open-meteo.com — free, NO API KEY needed) instead of synthetic
# noise, and genuinely raises risk-score confidence (~40% -> ~85%+) because
# those components' data-source tag becomes "real" instead of "simulated".
# See README.md "Real weather data (optional)" and docs/Data_Sources.md.
GIRIVARSHA_ACTIVE_RAINFALL_PROVIDER=simulated
GIRIVARSHA_ACTIVE_SOIL_PROVIDER=simulated
# "simulated" (default) or "real". "real" switches the SCS-CN estimate's
# Antecedent Moisture Condition (AMC) classification from a current-soil-
# moisture proxy to a real 5/10/20-day rainfall history from NASA POWER
# (https://power.larc.nasa.gov — free, NO API KEY needed). See README.md
# "Real antecedent-precipitation-index (optional)" and docs/Data_Sources.md.
GIRIVARSHA_ACTIVE_ANTECEDENT_PROVIDER=simulated
GIRIVARSHA_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# SMS-reach follow-up: "log_only" (default) records what WOULD be sent to
# each village's subscribers but never claims real delivery. Set to "twilio"
# plus a real Twilio trial/paid account's credentials below to actually
# send SMS on a real ORANGE/RED alert. See README.md "Real-time push + SMS
# alerts (optional)".
GIRIVARSHA_ACTIVE_SMS_PROVIDER=log_only
GIRIVARSHA_TWILIO_ACCOUNT_SID=
GIRIVARSHA_TWILIO_AUTH_TOKEN=
GIRIVARSHA_TWILIO_FROM_NUMBER=
