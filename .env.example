# Root-level env vars used by docker-compose. Copy to .env and adjust.
# Individual services also read backend/.env / frontend/.env for local (non-docker) runs.

POSTGRES_DB=girivarsha
POSTGRES_USER=girivarsha
POSTGRES_PASSWORD=change-me-locally

# Backend (see backend/app/core/config.py for the full list)
GIRIVARSHA_DATABASE_URL=postgresql+psycopg://girivarsha:change-me-locally@postgres:5432/girivarsha
GIRIVARSHA_ENVIRONMENT=development
GIRIVARSHA_ACTIVE_RAINFALL_PROVIDER=simulated
GIRIVARSHA_ACTIVE_SOIL_PROVIDER=simulated
GIRIVARSHA_ACTIVE_ANTECEDENT_PROVIDER=simulated

# Frontend
VITE_API_BASE_URL=http://localhost:8000
